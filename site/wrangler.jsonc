{
  "name": "gpuix-solid",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health"]
  },
  "observability": {
    "enabled": true
  }
}
