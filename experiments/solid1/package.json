{
  "name": "gpuix-solid1-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:test": "vite build --config vite.test.config.ts",
    "test:native": "bun run build:test && bun scripts/run-test.mjs",
    "check": "bun run typecheck && bun run build && bun run test:native",
    "start": "bun dist/app/index.js",
    "run": "bun run build && bun run start"
  },
  "dependencies": {
    "@gpuix/native": "^0.7.0",
    "@jhomra21/gpuix-solid1": "file:../../packages/solid1",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
