{
  "name": "gpuix-solid1-kobalte-showcase",
  "private": true,
  "type": "module",
  "scripts": {
    "host:build": "cd ../../packages/solid1 && bun install --no-save && bun run build",
    "build": "bun run host:build && vite build",
    "build:test": "bun run host:build && vite build --config vite.test.config.ts",
    "typecheck": "bun run host:build && tsc --noEmit",
    "test:native": "bun run build:test && bun scripts/run-test.mjs",
    "start": "bun dist/app/index.js",
    "run": "bun run build && bun run start"
  },
  "dependencies": {
    "@gpuix/native": "^0.5.1",
    "@jhomra21/gpuix-solid1": "file:../../packages/solid1",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
