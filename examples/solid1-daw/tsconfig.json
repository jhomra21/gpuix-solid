{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "exactOptionalPropertyTypes": false,
    "jsx": "preserve",
    "jsxImportSource": "@jhomra21/gpuix-solid1",
    "noEmit": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "solid-js/web": [
        "src/compat/solid-web.ts"
      ],
      "@daw-browser/waveforms/render-waveform": [
        "src/compat/render-waveform.ts"
      ],
      "~/hooks/useClipWaveformViewModel": [
        "src/compat/useClipWaveformViewModel.ts"
      ],
      "~/lib/timeline-runtime-types": [
        "src/upstream/lib/timeline-runtime-types.ts"
      ],
      "~/context/app-preferences": [
        "src/compat/app-preferences.ts"
      ],
      "~/hooks/useTransportTempoController": [
        "src/compat/useTransportTempoController.ts"
      ],
      "~/lib/clip-color": [
        "src/compat/clip-color.ts"
      ],
      "~/lib/project-save-status": [
        "src/compat/project-save-status.ts"
      ],
      "~/lib/timeline-left-browser-preferences": [
        "src/compat/timeline-left-browser-preferences.ts"
      ],
      "~/lib/timeline-range-selection": [
        "src/upstream/lib/timeline-range-selection.ts"
      ],
      "~/lib/timeline-storage": [
        "src/compat/timeline-storage.ts"
      ],
      "~/lib/timeline-track-layout": [
        "src/upstream/lib/timeline-track-layout.ts"
      ],
      "~/lib/timeline-utils": [
        "src/upstream/lib/timeline-utils.ts"
      ],
      "~/lib/timeline-view": [
        "src/compat/timeline-view.ts"
      ],
      "~/*": [
        "src/upstream/*"
      ],
      "@daw-browser/shared": [
        "src/compat/daw-browser-shared.ts"
      ],
      "@daw-browser/timeline-core/types": [
        "src/upstream/packages/timeline-core/types.ts"
      ],
      "@daw-browser/timeline-core/clip-fades": [
        "src/upstream/packages/timeline-core/clip-fades.ts"
      ],
      "@kobalte/core": [
        "../../packages/solid1/src/kobalte/index.tsx"
      ],
      "@kobalte/core/polymorphic": [
        "../../packages/solid1/src/kobalte/polymorphic.ts"
      ],
      "@kobalte/core/button": [
        "../../packages/solid1/src/kobalte/button.tsx"
      ],
      "@kobalte/core/image": [
        "../../packages/solid1/src/kobalte/image.tsx"
      ],
      "@kobalte/core/separator": [
        "../../packages/solid1/src/kobalte/separator.tsx"
      ],
      "@kobalte/core/text-field": [
        "../../packages/solid1/src/kobalte/text-field.tsx"
      ],
      "@kobalte/core/tooltip": [
        "../../packages/solid1/src/kobalte/tooltip.tsx"
      ],
      "@kobalte/core/dialog": [
        "../../packages/solid1/src/kobalte/dialog.tsx"
      ],
      "@kobalte/core/dropdown-menu": [
        "../../packages/solid1/src/kobalte/dropdown-menu.tsx"
      ],
      "@kobalte/core/context-menu": [
        "../../packages/solid1/src/kobalte/context-menu.tsx"
      ],
      "@kobalte/core/menubar": [
        "../../packages/solid1/src/kobalte/menubar.tsx"
      ],
      "@daw-browser/audio-engine/audio-engine": [
        "src/compat/audio-engine.ts"
      ],
      "@daw-browser/timeline-core/clip-placement": [
        "src/upstream/packages/timeline-core/clip-placement.ts"
      ],
      "@daw-browser/timeline-core/track-routing": [
        "src/upstream/packages/timeline-core/track-routing.ts"
      ],
      "~/hooks/useTimelineAutomationController": [
        "src/compat/useTimelineAutomationController.ts"
      ],
      "~/lib/color": [
        "src/upstream/lib/color.ts"
      ],
      "~/lib/preferences/app-preferences": [
        "src/compat/app-preferences.ts"
      ],
      "~/lib/timeline-layout": [
        "src/upstream/lib/timeline-layout.ts"
      ],
      "~/lib/track-group-ops": [
        "src/upstream/lib/track-group-ops.ts"
      ],
      "~/lib/track-sidebar-mixer": [
        "src/upstream/lib/track-sidebar-mixer.ts"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "vite*.config.ts",
    "kobalte-native-aliases.ts"
  ]
}
