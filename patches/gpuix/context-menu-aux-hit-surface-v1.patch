diff --git a/packages/native/src/renderer.rs b/packages/native/src/renderer.rs
--- a/packages/native/src/renderer.rs
+++ b/packages/native/src/renderer.rs
@@ -5510,6 +5510,33 @@ fn build_element(
             el.child(child)
         };
     }
 
+    // Context menus need to win secondary-button hit testing even when a nested
+    // label owns its own interactive hitbox. A final absolute child gives the
+    // right button a topmost normal hitbox without blocking primary clicks.
+    if element.events.contains("contextMenu") {
+        let id = element.id;
+        let callback = ctx.event_callback.clone();
+        el = el.child(
+            gpui::div()
+                .absolute()
+                .inset_0()
+                .on_aux_click(move |click_event, _window, _cx| {
+                    if !click_event.is_right_click() {
+                        return;
+                    }
+                    emit_event_full(&callback, id, "contextMenu", |p| {
+                        let (x, y) = point_to_xy(click_event.position());
+                        p.x = Some(x);
+                        p.y = Some(y);
+                        p.button = Some(2);
+                        p.click_count = Some(click_event.click_count() as u32);
+                        p.modifiers = Some(click_event.modifiers().into());
+                        p.is_right_click = Some(true);
+                    });
+                }),
+        );
+    }
+
     el.into_any_element()
 }
