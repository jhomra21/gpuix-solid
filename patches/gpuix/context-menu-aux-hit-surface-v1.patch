+            // ── Context menu (secondary press), like DOM `contextmenu` ──
+            //
+            // Use a capture-phase listener instead of an occluding hit surface:
+            // nested child hitboxes still participate in ordinary primary clicks,
+            // while a right-button press inside this element reaches the owner.
+            "contextMenu" => {
+                el = el.capture_any_mouse_down(move |mouse_event, _window, _cx| {
+                    if mouse_event.button != gpui::MouseButton::Right {
+                        return;
+                    }
+                    emit_event_full(&callback, id, "contextMenu", |p| {
+                        let (x, y) = point_to_xy(mouse_event.position);
+                        p.x = Some(x);
+                        p.y = Some(y);
+                        p.button = Some(2);
+                        p.click_count = Some(mouse_event.click_count as u32);
+                        p.modifiers = Some(mouse_event.modifiers.into());
+                        p.is_right_click = Some(true);
+                    });
+                });
+            }
+
