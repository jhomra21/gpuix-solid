+    /// Renders the scene to an offscreen texture and returns the pixel data as an RGBA image.
+    /// This does not consume a CAMetalLayer drawable, so visual tests cannot
+    /// interfere with the live window's presentation pool.
+    #[cfg(any(test, feature = "test-support"))]
