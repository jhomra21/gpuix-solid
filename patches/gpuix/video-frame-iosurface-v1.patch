+    pub fn clear_video_frame(&mut self, id: u64) {
+        let mut changed = self.video_frames.remove(&id).is_some();
+        #[cfg(target_os = "macos")]
+        {
+            changed |= self.video_frame_surfaces.remove(&id).is_some();
+        }
+        if changed {
             self.mark_render_changed(id);
         }
     }
