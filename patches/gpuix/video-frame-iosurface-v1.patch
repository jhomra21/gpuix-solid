+    #[cfg(target_os = "macos")]
+    pub fn set_video_frame_iosurface(&mut self, id: u64, handle: &[u8]) -> Result<(), String> {
+        let element = self
+            .elements
+            .get(&id)
+            .ok_or_else(|| format!("Video frame target {id} does not exist"))?;
+        if element.element_type != "video-frame" {
+            return Err(format!(
+                "Video frame target {id} is <{}>, expected <video-frame>",
+                element.element_type
+            ));
+        }
+
+        let surface =
+            crate::custom_elements::video_frame::pixel_buffer_from_iosurface_handle(handle)?;
+        self.video_frames.remove(&id);
+        self.video_frame_surfaces.insert(id, surface);
+        self.mark_render_changed(id);
+        Ok(())
+    }
