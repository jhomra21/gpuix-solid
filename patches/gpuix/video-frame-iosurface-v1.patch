 use super::{CustomElement, CustomElementFactory, CustomRenderContext};
 
 pub const VIDEO_FRAME_SURFACE_VERSION: u32 = 1;
+#[cfg(target_os = "macos")]
+pub const VIDEO_FRAME_IOSURFACE_VERSION: u32 = 1;
+
+#[cfg(target_os = "macos")]
+pub(crate) fn pixel_buffer_from_iosurface_handle(
+    handle: &[u8],
+) -> Result<core_video::pixel_buffer::CVPixelBuffer, String> {
+    use core_foundation::base::{kCFAllocatorDefault, TCFType};
+    use core_foundation::dictionary::CFDictionaryRef;
+    use core_video::pixel_buffer::{CVPixelBuffer, CVPixelBufferRef};
+    use std::ffi::c_void;
+    use std::mem::size_of;
+    use std::ptr::{null, null_mut};
+
+    #[link(name = "CoreVideo", kind = "framework")]
+    unsafe extern "C" {
+        fn CVPixelBufferCreateWithIOSurface(
+            allocator: core_foundation::base::CFAllocatorRef,
+            surface: *const c_void,
+            pixel_buffer_attributes: CFDictionaryRef,
+            pixel_buffer_out: *mut CVPixelBufferRef,
+        ) -> i32;
+    }
+
+    if handle.len() < size_of::<usize>() {
+        return Err(format!(
+            "IOSurface handle is {} bytes, expected at least {}",
+            handle.len(),
+            size_of::<usize>()
+        ));
+    }
+
+    let mut raw = [0u8; size_of::<usize>()];
+    raw.copy_from_slice(&handle[..size_of::<usize>()]);
+    let surface = usize::from_ne_bytes(raw) as *const c_void;
+    if surface.is_null() {
+        return Err("IOSurface handle is null".to_string());
+    }
+
+    let mut pixel_buffer: CVPixelBufferRef = null_mut();
+    let status = unsafe {
+        CVPixelBufferCreateWithIOSurface(
+            kCFAllocatorDefault,
+            surface,
+            null(),
+            &mut pixel_buffer,
+        )
+    };
+    if status != 0 || pixel_buffer.is_null() {
+        return Err(format!(
+            "CVPixelBufferCreateWithIOSurface failed with status {status}"
+        ));
+    }
+
+    Ok(unsafe { CVPixelBuffer::wrap_under_create_rule(pixel_buffer) })
+}
