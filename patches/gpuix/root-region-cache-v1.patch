+impl GpuixView {
+    fn build_retained_region(
+        &mut self,
+        id: u64,
+        window: &mut gpui::Window,
+        cx: &mut gpui::Context<Self>,
+    ) -> gpui::AnyElement {
+        let tree_arc = self.tree.clone();
+        let tree = tree_arc.lock().unwrap();
+        let callback = self.event_callback.clone();
+        let theme = Theme::dark();
+        let now = self.clock.now();
+        let mut highlight_events = Vec::new();
+        let mut inherited = Inherited::root(&theme);
+        if let Some(root_id) = tree.root_id {
+            if let Some(root) = tree.elements.get(&root_id) {
+                inherited = inherited.descend(root.style.as_deref());
+            }
+        }
+        let mut build_ctx = BuildCtx {
+            tree: &tree,
+            event_callback: &callback,
+            focus_handles: &self.focus_handles,
+            scroll_handles: &mut self.scroll_handles,
+            custom_registry: &mut self.custom_registry,
+            virtual_lists: &mut self.virtual_lists,
+            motion_states: &mut self.motion_states,
+            now,
+            selection: self.selection.clone(),
+            inherited,
+            highlights: &mut self.highlights,
+            highlight_events: &mut highlight_events,
+            root_regions: None,
+        };
+        let built = build_element(id, &mut build_ctx, window, cx);
+        emit_highlight_events(&callback, &highlight_events);
+        built
+    }
+}
+
+impl gpui::Render for RetainedRegionView {
+    fn render(
+        &mut self,
+        window: &mut gpui::Window,
+        cx: &mut gpui::Context<Self>,
+    ) -> impl gpui::IntoElement {
+        use gpui::IntoElement;
+        let Some(parent) = self.parent.upgrade() else {
+            return gpui::Empty.into_any_element();
+        };
+        parent.update(cx, |parent, parent_cx| {
+            parent.build_retained_region(self.element_id, window, parent_cx)
+        })
+    }
+}
