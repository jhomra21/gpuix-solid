+    /// Update one primitive text leaf without rebuilding the root GPUI view.
+    ///
+    /// Mounts and mixed commits still use applyBatch. This path exists for
+    /// isolated reactive labels (counters, zoom readouts, clocks) after their
+    /// text leaf has already been rendered once.
+    #[napi]
+    pub fn set_live_text(&self, element_id: f64, content: String) -> Result<()> {
+        let id = to_element_id(element_id)?;
+        let shared = gpui::SharedString::from(content.clone());
+        {
+            let mut tree = self.tree.lock().unwrap();
+            let element = tree
+                .elements
+                .get(&id)
+                .ok_or_else(|| Error::from_reason(format!("Unknown element id {id}")))?;
+            if element.element_type != "text" {
+                return Err(Error::from_reason(format!(
+                    "setLiveText is only valid on <text>, got <{}>",
+                    element.element_type
+                )));
+            }
+            tree.set_text(id, content);
+        }
+
+        #[cfg(target_os = "macos")]
+        return update_window(move |view, window, cx| {
+            if !view.set_live_text(id, shared, cx) {
+                cx.notify();
+                window.refresh();
+            }
+        });
+
+        #[cfg(any(target_os = "windows", target_os = "linux", target_os = "freebsd"))]
+        {
+            let _ = shared;
+            return self.request_invalidate();
+        }
+
+        #[cfg(not(any(
+            target_os = "macos",
+            target_os = "windows",
+            target_os = "linux",
+            target_os = "freebsd"
+        )))]
+        {
+            let _ = shared;
+            self.request_invalidate()
+        }
+    }
 
