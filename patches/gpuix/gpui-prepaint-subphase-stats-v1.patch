+impl DebugFrameOverlayMode {
+    /// Returns the next mode in the Hidden → FrameTime → Detailed cycle.
+    pub fn next(self) -> Self {
+        match self {
+            Self::Hidden => Self::Minimal,
+            Self::Minimal => Self::Full,
+            Self::Full => Self::Hidden,
+        }
+    }
+}
