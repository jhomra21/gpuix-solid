+pub(crate) struct DebugFrameOverlay {
+    mode: DebugFrameOverlayMode,
+    draw_durations: VecDeque<Duration>,
+    draw_roots_durations: VecDeque<Duration>,
+    prepaint_durations: VecDeque<Duration>,
+    paint_durations: VecDeque<Duration>,
+    root_request_durations: VecDeque<Duration>,
+    root_layout_durations: VecDeque<Duration>,
+    root_prepaint_durations: VecDeque<Duration>,
+    prepaint_rest_durations: VecDeque<Duration>,
+    cached_prepaint_reuse_durations: VecDeque<Duration>,
+    cached_prepaint_render_durations: VecDeque<Duration>,
+    cached_prepaint_reuse_current: Duration,
+    cached_prepaint_render_current: Duration,
+    total_frame_count: u64,
+}
+
+impl DebugFrameOverlay {
+    pub(crate) fn new() -> Self {
+        Self {
+            mode: DebugFrameOverlayMode::default(),
+            draw_durations: VecDeque::new(),
+            draw_roots_durations: VecDeque::new(),
+            prepaint_durations: VecDeque::new(),
+            paint_durations: VecDeque::new(),
+            root_request_durations: VecDeque::new(),
+            root_layout_durations: VecDeque::new(),
+            root_prepaint_durations: VecDeque::new(),
+            prepaint_rest_durations: VecDeque::new(),
+            cached_prepaint_reuse_durations: VecDeque::new(),
+            cached_prepaint_render_durations: VecDeque::new(),
+            cached_prepaint_reuse_current: Duration::ZERO,
+            cached_prepaint_render_current: Duration::ZERO,
+            total_frame_count: 0,
+        }
+    }
+
+    pub(crate) fn mode(&self) -> DebugFrameOverlayMode {
+        self.mode
+    }
+
+    pub(crate) fn set_mode(&mut self, mode: DebugFrameOverlayMode) {
+        self.mode = mode;
+    }
+
+    /// Clears the draw-duration samples, restarting the percentile window.
+    /// The total frame count is left untouched.
+    pub(crate) fn reset_stats(&mut self) {
+        self.draw_durations.clear();
+        self.draw_roots_durations.clear();
+        self.prepaint_durations.clear();
+        self.paint_durations.clear();
+        self.root_request_durations.clear();
+        self.root_layout_durations.clear();
+        self.root_prepaint_durations.clear();
+        self.prepaint_rest_durations.clear();
+        self.cached_prepaint_reuse_durations.clear();
+        self.cached_prepaint_render_durations.clear();
+        self.cached_prepaint_reuse_current = Duration::ZERO;
+        self.cached_prepaint_render_current = Duration::ZERO;
+    }
+
+    pub(crate) fn is_enabled(&self) -> bool {
+        self.mode != DebugFrameOverlayMode::Hidden
+    }
+
+    pub(crate) fn record_frame(&mut self, draw_duration: Duration) {
+        self.total_frame_count += 1;
+        Self::push_duration(&mut self.draw_durations, draw_duration);
+    }
+
+    pub(crate) fn record_draw_roots(&mut self, duration: Duration) {
+        Self::push_duration(&mut self.draw_roots_durations, duration);
+    }
+
+    pub(crate) fn record_prepaint(&mut self, duration: Duration) {
+        Self::push_duration(&mut self.prepaint_durations, duration);
+    }
+
+    pub(crate) fn record_paint(&mut self, duration: Duration) {
+        Self::push_duration(&mut self.paint_durations, duration);
+    }
+
+    pub(crate) fn record_root_request(&mut self, duration: Duration) {
+        Self::push_duration(&mut self.root_request_durations, duration);
+    }
+
+    pub(crate) fn record_root_layout(&mut self, duration: Duration) {
+        Self::push_duration(&mut self.root_layout_durations, duration);
+    }
+
+    pub(crate) fn record_root_prepaint(&mut self, duration: Duration) {
+        Self::push_duration(&mut self.root_prepaint_durations, duration);
+    }
+
+    pub(crate) fn record_prepaint_rest(&mut self, duration: Duration) {
+        Self::push_duration(&mut self.prepaint_rest_durations, duration);
+    }
+
+    pub(crate) fn begin_cached_prepaint_frame(&mut self) {
+        self.cached_prepaint_reuse_current = Duration::ZERO;
+        self.cached_prepaint_render_current = Duration::ZERO;
+    }
+
+    pub(crate) fn record_cached_prepaint_reuse(&mut self, duration: Duration) {
+        self.cached_prepaint_reuse_current += duration;
+    }
+
+    pub(crate) fn record_cached_prepaint_render(&mut self, duration: Duration) {
+        self.cached_prepaint_render_current += duration;
+    }
+
+    pub(crate) fn finish_cached_prepaint_frame(&mut self) {
+        Self::push_duration(
+            &mut self.cached_prepaint_reuse_durations,
+            self.cached_prepaint_reuse_current,
+        );
+        Self::push_duration(
+            &mut self.cached_prepaint_render_durations,
+            self.cached_prepaint_render_current,
+        );
+    }
+
+    fn push_duration(samples: &mut VecDeque<Duration>, duration: Duration) {
+        if samples.len() >= MAX_SAMPLES {
+            samples.pop_front();
+        }
+        samples.push_back(duration);
+    }
+
+    fn duration_summary(
+        samples: &VecDeque<Duration>,
+    ) -> (Option<f32>, Option<f32>, Option<f32>, usize) {
+        let mut sorted: Vec<Duration> = samples.iter().copied().collect();
+        sorted.sort_unstable();
+        let percentile = |numerator: usize| {
+            (!sorted.is_empty()).then(|| sorted[(sorted.len() - 1) * numerator / 100])
+        };
+        (
+            percentile(90).map(duration_ms),
+            percentile(99).map(duration_ms),
+            sorted.last().copied().map(duration_ms),
+            samples.len(),
+        )
+    }
+
+    pub(crate) fn stats(&self) -> DebugFrameOverlayStats {
+        let mut sorted: Vec<Duration> = self.draw_durations.iter().copied().collect();
+        sorted.sort_unstable();
+        let percentile = |numerator: usize| {
+            (!sorted.is_empty()).then(|| sorted[(sorted.len() - 1) * numerator / 100])
+        };
+        let (draw_roots_p90_ms, draw_roots_p99_ms, draw_roots_max_ms, draw_roots_samples) =
+            Self::duration_summary(&self.draw_roots_durations);
+        let (prepaint_p90_ms, prepaint_p99_ms, prepaint_max_ms, prepaint_samples) =
+            Self::duration_summary(&self.prepaint_durations);
+        let (paint_p90_ms, paint_p99_ms, paint_max_ms, paint_samples) =
+            Self::duration_summary(&self.paint_durations);
+        let (root_request_p90_ms, root_request_p99_ms, _, _) =
+            Self::duration_summary(&self.root_request_durations);
+        let (root_layout_p90_ms, root_layout_p99_ms, _, _) =
+            Self::duration_summary(&self.root_layout_durations);
+        let (root_prepaint_p90_ms, root_prepaint_p99_ms, _, _) =
+            Self::duration_summary(&self.root_prepaint_durations);
+        let (prepaint_rest_p90_ms, prepaint_rest_p99_ms, _, _) =
+            Self::duration_summary(&self.prepaint_rest_durations);
+        let (cached_prepaint_reuse_p90_ms, cached_prepaint_reuse_p99_ms, _, _) =
+            Self::duration_summary(&self.cached_prepaint_reuse_durations);
+        let (cached_prepaint_render_p90_ms, cached_prepaint_render_p99_ms, _, _) =
+            Self::duration_summary(&self.cached_prepaint_render_durations);
+        DebugFrameOverlayStats {
+            current_ms: self.draw_durations.back().copied().map(duration_ms),
+            p90_ms: percentile(90).map(duration_ms),
+            p99_ms: percentile(99).map(duration_ms),
+            max_ms: sorted.last().copied().map(duration_ms),
+            frames: self.total_frame_count,
+            samples: self.draw_durations.len(),
+            draw_roots_p90_ms,
+            draw_roots_p99_ms,
+            draw_roots_max_ms,
+            draw_roots_samples,
+            prepaint_p90_ms,
+            prepaint_p99_ms,
+            prepaint_max_ms,
+            prepaint_samples,
+            paint_p90_ms,
+            paint_p99_ms,
+            paint_max_ms,
+            paint_samples,
+            root_request_p90_ms,
+            root_request_p99_ms,
+            root_layout_p90_ms,
+            root_layout_p99_ms,
+            root_prepaint_p90_ms,
+            root_prepaint_p99_ms,
+            prepaint_rest_p90_ms,
+            prepaint_rest_p99_ms,
+            cached_prepaint_reuse_p90_ms,
+            cached_prepaint_reuse_p99_ms,
+            cached_prepaint_render_p90_ms,
+            cached_prepaint_render_p99_ms,
+        }
+    }
