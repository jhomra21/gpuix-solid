+const VIEW_RENDER_MAX_SAMPLES: usize = 1000;
+
+fn view_render_duration_ms(duration: Duration) -> f64 {
+    duration.as_secs_f64() * 1000.0
+}
+
+fn record_view_render_duration(duration: Duration) {
+    VIEW_RENDER_DURATIONS.with(|cell| {
+        let mut durations = cell.borrow_mut();
+        if durations.len() >= VIEW_RENDER_MAX_SAMPLES {
+            durations.pop_front();
+        }
+        durations.push_back(duration);
+    });
+}
+
+fn reset_view_render_stats() {
+    VIEW_RENDER_DURATIONS.with(|cell| cell.borrow_mut().clear());
+}
+
+fn view_render_stats() -> (Option<f64>, Option<f64>, Option<f64>, Option<f64>, f64) {
+    VIEW_RENDER_DURATIONS.with(|cell| {
+        let durations = cell.borrow();
+        let mut sorted: Vec<Duration> = durations.iter().copied().collect();
+        sorted.sort_unstable();
+        let percentile = |numerator: usize| {
+            (!sorted.is_empty()).then(|| sorted[(sorted.len() - 1) * numerator / 100])
+        };
+        (
+            durations.back().copied().map(view_render_duration_ms),
+            percentile(90).map(view_render_duration_ms),
+            percentile(99).map(view_render_duration_ms),
+            sorted.last().copied().map(view_render_duration_ms),
+            durations.len() as f64,
+        )
+    })
+}
+
