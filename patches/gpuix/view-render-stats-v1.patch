+
+const VIEW_RENDER_MAX_SAMPLES: usize = 1000;
+
+fn view_duration_ms(duration: Duration) -> f64 {
+    duration.as_secs_f64() * 1000.0
+}
+
+fn push_view_duration(samples: &mut VecDeque<Duration>, duration: Duration) {
+    if samples.len() >= VIEW_RENDER_MAX_SAMPLES {
+        samples.pop_front();
+    }
+    samples.push_back(duration);
+}
+
+fn summarize_view_durations(
+    samples: &VecDeque<Duration>,
+) -> (Option<f64>, Option<f64>, Option<f64>, Option<f64>, f64) {
+    let mut sorted: Vec<Duration> = samples.iter().copied().collect();
+    sorted.sort_unstable();
+    let percentile = |numerator: usize| {
+        (!sorted.is_empty()).then(|| sorted[(sorted.len() - 1) * numerator / 100])
+    };
+    (
+        samples.back().copied().map(view_duration_ms),
+        percentile(90).map(view_duration_ms),
+        percentile(99).map(view_duration_ms),
+        sorted.last().copied().map(view_duration_ms),
+        samples.len() as f64,
+    )
+}
+
+fn record_view_render_duration(duration: Duration) {
+    VIEW_RENDER_DURATIONS.with(|cell| push_view_duration(&mut cell.borrow_mut(), duration));
+}
+
+fn record_view_build_duration(duration: Duration) {
+    VIEW_BUILD_DURATIONS.with(|cell| push_view_duration(&mut cell.borrow_mut(), duration));
+}
+
+fn reset_view_render_stats() {
+    VIEW_RENDER_DURATIONS.with(|cell| cell.borrow_mut().clear());
+    VIEW_BUILD_DURATIONS.with(|cell| cell.borrow_mut().clear());
+}
+
+fn view_render_stats() -> (Option<f64>, Option<f64>, Option<f64>, Option<f64>, f64) {
+    VIEW_RENDER_DURATIONS.with(|cell| summarize_view_durations(&cell.borrow()))
+}
+
+fn view_build_stats() -> (Option<f64>, Option<f64>, Option<f64>, Option<f64>, f64) {
+    VIEW_BUILD_DURATIONS.with(|cell| summarize_view_durations(&cell.borrow()))
+}
+
