+                paint_with_clip(command.clip(), draw_list, bounds, window, |window| {
+                    let _ = window.paint_svg(
+                        svg_bounds,
+                        gpui::SharedString::from(svg.clone()),
+                        Some(svg.as_bytes()),
+                        transformation,
+                        color,
+                        cx,
+                    );
+                });
+            }
+            CanvasDrawCommand::DrawImage {
+                image_id,
+                source,
+                destination,
+                ..
+            } => {
+                let Some(resource) = images.get(image_id) else {
+                    log::warn!("Skipping missing GPUIX canvas image resource {image_id}");
+                    continue;
+                };
+                if source.width <= 0.0
+                    || source.height <= 0.0
+                    || destination.width <= 0.0
+                    || destination.height <= 0.0
+                {
+                    continue;
+                }
+                let image_scale_x = destination.width / source.width;
+                let image_scale_y = destination.height / source.height;
+                let visible = canvas_image_bounds(destination, bounds, scale_x, scale_y);
+                let full = CanvasImageRect {
+                    x: destination.x - source.x * image_scale_x,
+                    y: destination.y - source.y * image_scale_y,
+                    width: resource.width as f32 * image_scale_x,
+                    height: resource.height as f32 * image_scale_y,
+                };
+                let full = canvas_image_bounds(&full, bounds, scale_x, scale_y);
+                paint_with_clip(command.clip(), draw_list, bounds, window, |window| {
+                    let _ = window.paint_image(
+                        visible,
+                        full,
+                        gpui::Corners::default(),
+                        resource.image.clone(),
+                        0,
+                        false,
+                    );
+                });
