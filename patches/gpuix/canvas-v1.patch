+                // GPUI's glyph paint API fixes sprite transforms to identity. For rotated
+                // Canvas text, rasterize the already-shaped line as a compact SVG alpha mask
+                // and apply GPUI's public sprite TransformationMatrix around the Canvas anchor.
+                // The fast glyph path above remains active for the common unrotated case.
+                let pad = 2.0_f32;
+                let svg_width = (width + pad * 2.0).max(1.0);
+                let svg_height = (font_size * 1.2 + pad * 2.0).max(1.0);
+                let svg_bounds = gpui::Bounds {
+                    origin: gpui::point(
+                        anchor.x - gpui::px(align_offset + pad),
+                        anchor.y - gpui::px(y_offset + pad),
+                    ),
+                    size: gpui::size(gpui::px(svg_width), gpui::px(svg_height)),
+                };
