+}
+
+fn append_path(
+    builder: &mut gpui::PathBuilder,
+    path: &[CanvasPathSegment],
+    bounds: gpui::Bounds<gpui::Pixels>,
+    scale_x: f32,
+    scale_y: f32,
+) {
+    let point = |x: f32, y: f32| {
+        gpui::point(
+            bounds.origin.x + gpui::px(x * scale_x),
+            bounds.origin.y + gpui::px(y * scale_y),
+        )
+    };
+    for segment in path {
+        match *segment {
+            CanvasPathSegment::MoveTo { x, y } => builder.move_to(point(x, y)),
+            CanvasPathSegment::LineTo { x, y } => builder.line_to(point(x, y)),
+            CanvasPathSegment::QuadraticCurveTo { cpx, cpy, x, y } => {
+                builder.curve_to(point(x, y), point(cpx, cpy))
+            }
+            CanvasPathSegment::BezierCurveTo {
+                cp1x,
+                cp1y,
+                cp2x,
+                cp2y,
+                x,
+                y,
+            } => builder.cubic_bezier_to(
+                point(x, y),
+                point(cp1x, cp1y),
+                point(cp2x, cp2y),
+            ),
+            CanvasPathSegment::ClosePath => builder.close(),
+        }
+    }
+}
+
+fn canvas_text_transform_scale(transform: &[f32; 6]) -> f32 {
+    let scale_x = transform[0].hypot(transform[1]);
+    let scale_y = transform[2].hypot(transform[3]);
+    ((scale_x + scale_y) / 2.0).max(0.0001)
+}
+
+fn canvas_text_transform_point(x: f32, y: f32, transform: &[f32; 6]) -> (f32, f32) {
+    (
+        transform[0] * x + transform[2] * y + transform[4],
+        transform[1] * x + transform[3] * y + transform[5],
+    )
+}
+
+fn canvas_text_screen_linear(
+    transform: &[f32; 6],
+    surface_scale_x: f32,
+    surface_scale_y: f32,
+) -> [[f32; 2]; 2] {
+    let scale = canvas_text_transform_scale(transform);
+    let safe_x = surface_scale_x.abs().max(0.0001);
+    let safe_y = surface_scale_y.abs().max(0.0001);
+    [
+        [transform[0] / scale, transform[2] / scale * safe_x / safe_y],
+        [transform[1] / scale * safe_y / safe_x, transform[3] / scale],
+    ]
+}
+
+fn canvas_text_linear_is_identity(linear: [[f32; 2]; 2]) -> bool {
+    let tolerance = 1e-5_f32;
+    (linear[0][0] - 1.0).abs() <= tolerance
+        && linear[0][1].abs() <= tolerance
+        && linear[1][0].abs() <= tolerance
+        && (linear[1][1] - 1.0).abs() <= tolerance
+}
+
+fn canvas_text_gpui_transform(
+    linear: [[f32; 2]; 2],
+    anchor: gpui::Point<gpui::Pixels>,
+    scale_factor: f32,
+) -> gpui::TransformationMatrix {
+    let anchor_x = f32::from(anchor.x) * scale_factor;
+    let anchor_y = f32::from(anchor.y) * scale_factor;
+    gpui::TransformationMatrix {
+        rotation_scale: linear,
+        translation: [
+            anchor_x - linear[0][0] * anchor_x - linear[0][1] * anchor_y,
+            anchor_y - linear[1][0] * anchor_x - linear[1][1] * anchor_y,
+        ],
+    }
+}
+
+fn canvas_text_svg(
+    text: &str,
+    font_family: &str,
+    font_weight: f32,
+    font_size: f32,
+    width: f32,
+    height: f32,
+    pad: f32,
+) -> String {
+    let text = canvas_escape_xml_text(text);
+    let font_family = canvas_escape_xml_attribute(font_family);
+    format!(
+        r#"<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}"><text x="{pad}" y="{}" fill="#fff" font-family="{font_family}" font-size="{font_size}" font-weight="{font_weight}">{text}</text></svg>"#,
+        pad + font_size * 0.8,
+    )
+}
+
+fn canvas_escape_xml_text(value: &str) -> String {
+    value
+        .replace('&', "&amp;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+}
+
+fn canvas_escape_xml_attribute(value: &str) -> String {
+    canvas_escape_xml_text(value)
+        .replace('"', "&quot;")
+        .replace('\'', "&apos;")
+}
+
+fn canvas_scale(
+    draw_list: &CanvasDrawList,
+    bounds: gpui::Bounds<gpui::Pixels>,
+) -> (f32, f32, f32) {
+    let scale_x = f32::from(bounds.size.width) / draw_list.width.max(0.01);
+    let scale_y = f32::from(bounds.size.height) / draw_list.height.max(0.01);
+    let text_scale = ((scale_x.abs() + scale_y.abs()) / 2.0).max(0.01);
+    (scale_x, scale_y, text_scale)
+}
+
+fn canvas_color(value: &str, alpha: f32) -> Option<gpui::Hsla> {
+    let mut color: gpui::Hsla = crate::color::parse_color_rgba(value)?.into();
+    color.a *= alpha.clamp(0.0, 1.0);
+    Some(color)
+}
