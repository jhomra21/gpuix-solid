+use gpui::prelude::*;
+use serde::Deserialize;
+use std::cell::RefCell;
+use std::collections::{HashMap, VecDeque};
+use std::sync::{Arc, RwLock};
+use std::time::{Duration, Instant};
+
+use super::{CustomElement, CustomElementFactory, CustomRenderContext};
+
+pub const CANVAS_DRAW_LIST_VERSION: u32 = 5;
+
+thread_local! {
+    static CANVAS_PREPARE_DURATIONS: RefCell<VecDeque<Duration>> = RefCell::new(VecDeque::new());
+}
+
+const CANVAS_PREPARE_MAX_SAMPLES: usize = 1000;
+
+fn record_canvas_prepare_duration(duration: Duration) {
+    CANVAS_PREPARE_DURATIONS.with(|cell| {
+        let mut samples = cell.borrow_mut();
+        if samples.len() >= CANVAS_PREPARE_MAX_SAMPLES {
+            samples.pop_front();
+        }
+        samples.push_back(duration);
+    });
+}
+
+pub(crate) fn reset_canvas_prepare_stats() {
+    CANVAS_PREPARE_DURATIONS.with(|cell| cell.borrow_mut().clear());
+}
+
+pub(crate) fn canvas_prepare_stats() -> (Option<f64>, Option<f64>, Option<f64>, f64) {
+    CANVAS_PREPARE_DURATIONS.with(|cell| {
+        let samples = cell.borrow();
+        let mut sorted: Vec<Duration> = samples.iter().copied().collect();
+        sorted.sort_unstable();
+        let percentile = |numerator: usize| {
+            (!sorted.is_empty()).then(|| sorted[(sorted.len() - 1) * numerator / 100])
+        };
+        let to_ms = |duration: Duration| duration.as_secs_f64() * 1000.0;
+        (
+            percentile(90).map(to_ms),
+            percentile(99).map(to_ms),
+            sorted.last().copied().map(to_ms),
+            samples.len() as f64,
+        )
+    })
+}
 
