+fn stacked_child_ids(
+    element: &crate::retained_tree::RetainedElement,
+    tree: &RetainedTree,
+) -> Vec<u64> {
+    let mut children: Vec<(usize, u64, f64)> = element
+        .children
+        .iter()
+        .copied()
+        .enumerate()
+        .filter_map(|(index, child_id)| {
+            let child = tree.elements.get(&child_id)?;
+            let z_index = child.style.as_deref().and_then(|style| style.z_index).unwrap_or(0.0);
+            Some((index, child_id, z_index))
+        })
+        .collect();
+    children.sort_by(|left, right| left.2.total_cmp(&right.2).then_with(|| left.0.cmp(&right.0)));
+    children.into_iter().map(|(_, child_id, _)| child_id).collect()
+}
