+fn cached_style_refinement<'a>(
+    cache: &'a mut HashMap<usize, CachedStyleRefinement>,
+    style: &Arc<StyleDesc>,
+) -> &'a gpui::StyleRefinement {
+    let key = Arc::as_ptr(style) as usize;
+    let is_hit = match cache.get(&key).and_then(|entry| entry.source.upgrade()) {
+        Some(source) => Arc::ptr_eq(&source, style),
+        None => false,
+    };
+    if !is_hit {
+        cache.insert(
+            key,
+            CachedStyleRefinement {
+                source: Arc::downgrade(style),
+                refinement: apply_styles(gpui::StyleRefinement::default(), style.as_ref()),
+            },
+        );
+    }
+    &cache.get(&key).expect("compiled style inserted").refinement
+}
+
+fn apply_interactive_styles_cached<E>(
+    mut el: E,
+    style: &StyleDesc,
+    shared_style: Option<&Arc<StyleDesc>>,
+    cache: &mut HashMap<usize, CachedStyleRefinement>,
+) -> E
+where
+    E: gpui::Styled + gpui::StatefulInteractiveElement,
+{
+    if let Some(shared_style) = shared_style {
+        *el.style() = cached_style_refinement(cache, shared_style).clone();
+    } else {
+        el = apply_styles(el, style);
+    }
+    if let Some(hover_style) = style.hover.as_deref() {
+        el = el.hover(|refinement| apply_styles(refinement, hover_style));
+    }
+    if let Some(active_style) = style.active.as_deref() {
+        el = el.active(|refinement| apply_styles(refinement, active_style));
+    }
+    el
+}
+
 /// Base styles plus gpui's `hover` and `active` refinements.
 ///
 /// Every stateful GPUI root must go through this, never `apply_styles` alone.
