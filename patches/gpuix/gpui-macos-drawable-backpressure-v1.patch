+    pub fn draw(&mut self, scene: &Scene) -> bool {
+        let mut recycle_age_ms = None;
+        if self.drawable_backpressure_enabled
+            && self.drawable_in_flight.load(Ordering::Acquire)
+        {
+            let presented_age = self
+                .drawable_presented_at
+                .lock()
+                .as_ref()
+                .map(Instant::elapsed);
+            let ready =
+                presented_age.is_some_and(|age| age >= Duration::from_millis(16));
+            if ready {
+                recycle_age_ms =
+                    presented_age.map(|age| age.as_secs_f64() * 1000.0);
+                self.drawable_in_flight.store(false, Ordering::Release);
+                *self.drawable_presented_at.lock() = None;
+            } else {
+                return false;
+            }
+        }
+
+        if self.drawable_backpressure_enabled
+            && self
+                .drawable_in_flight
+                .compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire)
+                .is_err()
+        {
+            return false;
+        }
+        if self.drawable_backpressure_enabled {
+            *self.drawable_presented_at.lock() = None;
+        }
+
+        let release_backpressure = |renderer: &Self| {
+            renderer.drawable_in_flight.store(false, Ordering::Release);
+            *renderer.drawable_presented_at.lock() = None;
+        };
+
+        let layer = match &self.layer {
+            Some(l) => l.clone(),
+            None => {
+                release_backpressure(self);
+                log::error!(
+                    "draw() called on headless renderer - use render_scene_to_image() instead"
+                );
+                return false;
+            }
+        };
+        let viewport_size = layer.drawable_size();
+        let viewport_size: Size<DevicePixels> = size(
+            (viewport_size.width.ceil() as i32).into(),
+            (viewport_size.height.ceil() as i32).into(),
+        );
+        let drawable_started = Instant::now();
+        let drawable = if let Some(drawable) = layer.next_drawable() {
+            drawable
+        } else {
+            release_backpressure(self);
+            log::error!(
+                "failed to retrieve next drawable, drawable size: {:?}",
+                viewport_size
+            );
+            return false;
+        };
+        let drawable_wait_ms = drawable_started.elapsed().as_secs_f64() * 1000.0;
+        if drawable_wait_ms >= 20.0 {
+            eprintln!(
+                "[gpuix][perf] metal nextDrawable {drawable_wait_ms:.2}ms recycle-age={:.2}ms transaction={}",
+                recycle_age_ms.unwrap_or(-1.0),
+                self.presents_with_transaction
+            );
+        }
+
+        if self.drawable_backpressure_enabled {
+            let drawable_presented_at = self.drawable_presented_at.clone();
+            let block = ConcreteBlock::new(move |_| {
+                *drawable_presented_at.lock() = Some(Instant::now());
+            });
+            let block = block.copy();
+            drawable.add_presented_handler(&block);
+        }
+
+        let command_buffer = match self.render_frame(scene, drawable.texture(), viewport_size) {
+            Ok(command_buffer) => command_buffer,
+            Err(error) => {
+                release_backpressure(self);
+                log::error!("failed to render: {error:#}");
+                return false;
+            }
+        };
+
+        if self.presents_with_transaction {
+            command_buffer.commit();
+            command_buffer.wait_until_scheduled();
+            drawable.present();
+        } else {
+            command_buffer.present_drawable(drawable);
+            command_buffer.commit();
+        }
+        true
+    }
 
