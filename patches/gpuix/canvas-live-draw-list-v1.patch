+    /// Push a high-frequency prop into an already-mounted custom element.
+    ///
+    /// Returns false when the adapter has not rendered yet; callers should
+    /// fall back to a normal view invalidation in that case.
+    pub fn set_live_prop_if_present(
+        &mut self,
+        id: u64,
+        element_type: &str,
+        key: &str,
+        value: serde_json::Value,
+    ) -> bool {
+        let Some(entry) = self.instances.get_mut(&id) else {
+            return false;
+        };
+        if entry.element_type != element_type {
+            return false;
+        }
+        entry.element.set_prop(key, value.clone());
+        entry.applied_props.insert(key.to_string(), value);
+        true
+    }
