+    /// Replace one Canvas2D draw list without rebuilding the retained host tree.
+    ///
+    /// The retained prop is still updated so automation and later full renders
+    /// observe the latest frame. Once the Canvas adapter has mounted, macOS can
+    /// repaint the cached GPUI view directly from the live shared draw-list slot.
+    #[napi]
+    pub fn set_canvas_draw_list(&self, element_id: f64, json: String) -> Result<()> {
+        let id = to_element_id(element_id)?;
+        let value: serde_json::Value = serde_json::from_str(&json)
+            .map_err(|error| Error::from_reason(format!("Invalid Canvas draw-list JSON: {error}")))?;
+        {
+            let mut tree = self.tree.lock().unwrap();
+            let element = tree
+                .elements
+                .get_mut(&id)
+                .ok_or_else(|| Error::from_reason(format!("Unknown element id {id}")))?;
+            if element.element_type != "canvas" {
+                return Err(Error::from_reason(format!(
+                    "setCanvasDrawList is only valid on <canvas>, got <{}>",
+                    element.element_type
+                )));
+            }
+            element.custom_props.insert("drawList".to_string(), value.clone());
+        }
+
+        #[cfg(target_os = "macos")]
+        return update_window(move |view, window, cx| {
+            if view
+                .custom_registry
+                .set_live_prop_if_present(id, "canvas", "drawList", value)
+            {
+                window.refresh();
+            } else {
+                cx.notify();
+                window.refresh();
+            }
+        });
+
+        #[cfg(not(target_os = "macos"))]
+        {
+            let _ = value;
+            self.request_invalidate()
+        }
+    }
