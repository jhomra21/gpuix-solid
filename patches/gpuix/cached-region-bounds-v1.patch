+pub fn shared_bounds_snapshot() -> SharedBoundsSnapshot {
+    Arc::new(Mutex::new(HashMap::new()))
+}
+
 /// Zero-size canvas. Keep it ahead of the app subtree under the root.
 ///
 /// Everything here is recorded during **paint**, never prepaint: gpui's
 /// `List::prepaint` speculatively prepaints a row range and can roll the window
 /// back and prepaint a different one, so a prepaint-recorded box can belong to a
 /// row that never reached the screen.
 pub fn bounds_frame_reset() -> impl IntoElement {
+    bounds_frame_reset_with_regions(Vec::new())
+}
+
+/// Reset frame-local bounds while preserving geometry for GPUI-cached root regions.
+///
+/// Cached views reuse prepaint/paint ranges and therefore do not rerun descendant
+/// `on_painted` callbacks. For an unchanged cached region, capture its completed
+/// previous-frame bounds before clearing the global map, then replay that snapshot
+/// into the new frame. Invalidated/new regions pass `preserve_previous = false`
+/// and repaint their bounds normally.
+pub fn bounds_frame_reset_with_regions(
+    regions: Vec<(SharedBoundsSnapshot, Vec<u64>, bool)>,
+) -> impl IntoElement {
     canvas(
         |_, _, _| (),
         move |_, _, _, _| {
-            BOUNDS.with(|cell| cell.borrow_mut().clear());
+            BOUNDS.with(|cell| {
+                let mut current = cell.borrow_mut();
+
+                for (snapshot, ids, preserve_previous) in &regions {
+                    if !preserve_previous {
+                        continue;
+                    }
+                    if let Ok(mut previous) = snapshot.lock() {
+                        previous.clear();
+                        previous.reserve(ids.len());
+                        for id in ids {
+                            if let Some(bounds) = current.get(id).copied() {
+                                previous.insert(*id, bounds);
+                            }
+                        }
+                    }
+                }
+
+                current.clear();
+                for (snapshot, _, _) in &regions {
+                    if let Ok(previous) = snapshot.lock() {
+                        current.extend(previous.iter().map(|(id, bounds)| (*id, *bounds)));
+                    }
+                }
+            });
         },
     )
     .absolute()
     .w(px(0.0))
     .h(px(0.0))
 }
