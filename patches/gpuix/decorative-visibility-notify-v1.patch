+#[derive(Copy, Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+enum BatchInvalidation {
+    None,
+    View,
+    Window,
+}
+
+struct AppliedBatch {
+    destroyed_ids: Vec<f64>,
+    invalidation: BatchInvalidation,
+}
+
+/// A soft view update is intentionally limited to a decorative positioned leaf
+/// toggling only `display: none`. It cannot reflow siblings and owns no event,
+/// text, custom-element, or child state that requires a full window refresh.
+fn style_batch_invalidation(
+    tree: &RetainedTree,
+    id: u64,
+    next: &StyleDesc,
+) -> BatchInvalidation {
+    let Some(element) = tree.elements.get(&id) else {
+        return BatchInvalidation::Window;
+    };
+    let Some(current) = element.style.as_deref() else {
+        return BatchInvalidation::Window;
+    };
+    if current == next {
+        return BatchInvalidation::None;
+    }
+    if element.element_type != "div"
+        || !element.children.is_empty()
+        || element.content.is_some()
+        || !element.events.is_empty()
+        || !element.custom_props.is_empty()
+        || element.auto_focus
+    {
+        return BatchInvalidation::Window;
+    }
+
+    let mut comparable = (*current).clone();
+    comparable.display = next.display.clone();
+    if comparable != *next
+        || !matches!(next.position.as_deref(), Some("absolute") | Some("fixed"))
+    {
+        return BatchInvalidation::Window;
+    }
+
+    let current_hidden = current.display.as_deref() == Some("none");
+    let next_hidden = next.display.as_deref() == Some("none");
+    if current_hidden == next_hidden {
+        return BatchInvalidation::Window;
+    }
+    BatchInvalidation::View
+}
