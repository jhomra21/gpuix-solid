 fn retained_region_layout_safe(style: Option<&StyleDesc>) -> bool {
     let Some(style) = style else {
         return false;
     };
     let definite = |value: Option<&crate::style::DimensionValue>| {
         matches!(
             value,
             Some(crate::style::DimensionValue::Pixels(_))
                 | Some(crate::style::DimensionValue::Percentage(_))
         )
     };
-    definite(style.width.as_ref()) && definite(style.height.as_ref())
+    let absolute = style.position.as_deref() == Some("absolute");
+    let width_is_definite =
+        definite(style.width.as_ref()) || (absolute && style.left.is_some() && style.right.is_some());
+    let height_is_definite = definite(style.height.as_ref())
+        || (absolute && style.top.is_some() && style.bottom.is_some());
+    width_is_definite && height_is_definite
+}
+
+fn retained_region_passthrough_safe(style: Option<&StyleDesc>) -> bool {
+    let Some(style) = style else {
+        return false;
+    };
+    let min_height_zero = matches!(
+        style.min_height.as_ref(),
+        Some(crate::style::DimensionValue::Pixels(value)) if *value == 0.0
+    );
+    style.flex_grow.is_some_and(|value| value > 0.0) && min_height_zero
+}
+
+fn retained_region_scroll_passthrough_safe(style: Option<&StyleDesc>) -> bool {
+    let Some(style) = style else {
+        return false;
+    };
+    let scrolls = |value: Option<&String>| {
+        matches!(value.map(String::as_str), Some("auto" | "scroll"))
+    };
+    scrolls(style.overflow.as_ref())
+        || scrolls(style.overflow_x.as_ref())
+        || scrolls(style.overflow_y.as_ref())
 }
 
