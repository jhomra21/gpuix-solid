+fn direct_root_region_id(tree: &RetainedTree, id: u64) -> Option<u64> {
+    let root_id = tree.root_id?;
+    if id == root_id {
+        return None;
+    }
+    let mut current = id;
+    loop {
+        let element = tree.elements.get(&current)?;
+        match element.parent {
+            Some(parent) if parent == root_id => return Some(current),
+            Some(parent) => current = parent,
+            None => return None,
+        }
+    }
+}
