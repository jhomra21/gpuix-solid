+    /// Get complete native scroll geometry:
+    /// [offsetX, offsetY, maxScrollX, maxScrollY, viewportWidth, viewportHeight].
+    #[napi]
+    pub fn get_scroll_metrics(&self, element_id: f64) -> Result<Option<Vec<f64>>> {
+        let id = to_element_id(element_id)?;
+        with_test_state(|cx, window, view| {
+            let view = view.clone();
+            let result = cx
+                .update_window(window, |_, _window, app| {
+                    view.update(app, |view, _cx| {
+                        if let Some(metrics) = view.virtual_list_metrics(id) {
+                            return Some(metrics.to_vec());
+                        }
+                        view.scroll_handles.get(&id).map(|handle| {
+                            let offset = handle.offset();
+                            let max = handle.max_offset();
+                            let bounds = handle.bounds();
+                            vec![
+                                f64::from(f32::from(offset.x)),
+                                f64::from(f32::from(offset.y)),
+                                f64::from(f32::from(max.x)),
+                                f64::from(f32::from(max.y)),
+                                f64::from(f32::from(bounds.size.width)),
+                                f64::from(f32::from(bounds.size.height)),
+                            ]
+                        })
+                    })
+                })
+                .map_err(|e| Error::from_reason(e.to_string()))?;
+            Ok(result)
+        })
+    }
