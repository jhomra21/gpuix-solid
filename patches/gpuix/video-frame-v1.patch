@@ -0,0 +1,126 @@
+use gpui::prelude::*;
+
+use super::{CustomElement, CustomElementFactory, CustomRenderContext};
+
+pub const VIDEO_FRAME_SURFACE_VERSION: u32 = 1;
+
+#[derive(Debug, Clone, Default)]
+enum VideoFrameObjectFit {
+    Fill,
+    #[default]
+    Contain,
+    Cover,
+    ScaleDown,
+    None,
+}
+
+impl VideoFrameObjectFit {
+    fn from_str(value: &str) -> Self {
+        match value {
+            "fill" => Self::Fill,
+            "cover" => Self::Cover,
+            "scaleDown" => Self::ScaleDown,
+            "none" => Self::None,
+            _ => Self::Contain,
+        }
+    }
+
+    fn as_gpui(&self) -> gpui::ObjectFit {
+        match self {
+            Self::Fill => gpui::ObjectFit::Fill,
+            Self::Contain => gpui::ObjectFit::Contain,
+            Self::Cover => gpui::ObjectFit::Cover,
+            Self::ScaleDown => gpui::ObjectFit::ScaleDown,
+            Self::None => gpui::ObjectFit::None,
+        }
+    }
+}
+
+#[derive(Default)]
+pub struct VideoFrameElement {
+    object_fit: VideoFrameObjectFit,
+    alt: String,
+}
+
+pub struct VideoFrameFactory;
+
+impl CustomElementFactory for VideoFrameFactory {
+    fn element_type(&self) -> &str {
+        "video-frame"
+    }
+
+    fn create(&self, _id: u64) -> Box<dyn CustomElement> {
+        Box::new(VideoFrameElement::default())
+    }
+}
+
+impl CustomElement for VideoFrameElement {
+    fn render(
+        &mut self,
+        ctx: CustomRenderContext,
+        _window: &mut gpui::Window,
+        _cx: &mut gpui::Context<crate::renderer::GpuixView>,
+    ) -> gpui::AnyElement {
+        let element_id = gpui::SharedString::from(format!("__gpuix_video_frame_{}", ctx.id));
+        let Some(frame) = ctx.video_frame.clone() else {
+            let mut fallback = super::custom_surface(gpui::div().id(element_id), &ctx);
+            fallback = crate::accessibility::apply_accessibility(
+                fallback,
+                ctx.props,
+                Some(gpui::Role::Image),
+            );
+            fallback = crate::accessibility::apply_image_label(fallback, ctx.props, &self.alt);
+            return fallback.into_any_element();
+        };
+
+        let mut image = gpui::img(frame)
+            .object_fit(self.object_fit.as_gpui())
+            .id(element_id);
+
+        if let Some(style) = ctx.style {
+            image = crate::renderer::apply_interactive_styles(image, style);
+            if let (
+                Some(crate::style::DimensionValue::Pixels(width)),
+                Some(crate::style::DimensionValue::Pixels(height)),
+            ) = (style.width.as_ref(), style.height.as_ref())
+            {
+                if *width > 0.0 && *height > 0.0 {
+                    image = image.aspect_ratio((*width as f32) / (*height as f32));
+                }
+            }
+        }
+
+        image = crate::accessibility::apply_accessibility(
+            image,
+            ctx.props,
+            Some(gpui::Role::Image),
+        );
+        image = crate::accessibility::apply_image_label(image, ctx.props, &self.alt);
+        let image = super::wire_standard_events(image, &ctx);
+        crate::automation::track_own_bounds(image, ctx.id).into_any_element()
+    }
+
+    fn set_prop(&mut self, key: &str, value: serde_json::Value) {
+        match key {
+            "objectFit" => {
+                self.object_fit = value
+                    .as_str()
+                    .map(VideoFrameObjectFit::from_str)
+                    .unwrap_or_default()
+            }
+            "alt" => self.alt = value.as_str().unwrap_or_default().to_string(),
+            _ => {}
+        }
+    }
+
+    fn supported_props(&self) -> &'static [&'static str] {
+        &["objectFit", "alt"]
+    }
+
+    fn supported_events(&self) -> &'static [&'static str] {
+        &["click", "mouseEnter", "mouseLeave", "fileDrop"]
+    }
+
+    fn destroy(&mut self) {}
+}
+
